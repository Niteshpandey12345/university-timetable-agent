# Copy to .env. Everything works WITHOUT a key (rule-based supervisor + template explanations);
# a key adds free-form understanding, the ReAct assistant and natural-language explanations.

# Google Gemini (free tier) -- picked automatically when set
GOOGLE_API_KEY=
# MODEL_NAME=gemini-3.6-flash

# or Anthropic Claude
# ANTHROPIC_API_KEY=
# MODEL_NAME=claude-sonnet-4-6

# Force a provider: auto | google | anthropic | openai | ollama | none
# MODEL_PROVIDER=auto

# Optional overrides
# TTAGENT_WORKBOOK=data/raw/Master_TimeTable_July-Dec-2026.xlsm
# TTAGENT_APPROVAL=1        # API: ask before publishing
# TTAGENT_SOLVE_S=60        # agent solve budget (seconds)
